{
  "name": "ui-dict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/sync-demofiles.mjs && node scripts/qa-demofiles.mjs && node scripts/gen-client-data.mjs",
    "new-term": "node scripts/new-term.mjs",
    "audit": "node scripts/audit-page.mjs",
    "predev": "pnpm gen",
    "dev": "astro dev",
    "prebuild": "pnpm gen",
    "build": "astro build",
    "preview": "astro preview",
    "qa": "node scripts/sync-demofiles.mjs && node scripts/qa-demofiles.mjs",
    "regression": "node scripts/regression-check.mjs",
    "verify:origin": "node scripts/verify-same-origin.mjs",
    "verify:grid": "node scripts/verify-live-grid.mjs",
    "verify:grid-edge": "node scripts/verify-live-edge.mjs",
    "verify:marquee": "node scripts/verify-marquee.mjs && node scripts/verify-marquee-page.mjs",
    "replay": "node scripts/replay-test.mjs",
    "replay:dry": "node scripts/replay-test.mjs --all --dry-run",
