    "replay:status": "node scripts/replay-test.mjs --status"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.0",
    "minisearch": "^7.0.0",
    "shiki": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
